{
  "name": "dsh-agent-team",
  "version": "0.1.0-dev.5",
  "description": "Local expert-team orchestration plugin for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./agent-roster": "./src/agent-roster.mjs",
    "./agent-team-settings": "./src/agent-team-settings.mjs",
    "./cli-adapter": "./src/cli-adapter.mjs",
    "./mission-plan": "./src/mission-plan.mjs",
    "./mission-ledger": "./src/mission-ledger.mjs",
    "./mission-run": "./src/mission-run.mjs",
    "./mission-snapshot": "./src/mission-snapshot.mjs",
    "./run-projection": "./src/run-projection.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "src/**/*.mjs",
    "lib/client.js",
    "lib/typert.host.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/agent-role-policy.mjs && node --check src/agent-roster.mjs && node --check src/agent-team-settings.mjs && node --check src/cli-adapter.mjs && node --check src/mission-plan.mjs && node --check src/mission-ledger.mjs && node --check src/mission-run.mjs && node --check src/mission-snapshot.mjs && node --check src/run-projection.mjs && node --check src/index.mjs && node --check lib/client.js && node --check lib/typert.host.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "zod": "4.4.3"
  },
  "license": "UNLICENSED"
}
